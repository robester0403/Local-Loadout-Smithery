{
  "name": "local-loadout-smithery",
  "version": "0.0.1",
  "description": "The control panel for your Claude Code loadout — skills, commands, subagents, and MCPs.",
  "bin": {
    "local-loadout-smithery": "./dist/server/src/index.js",
    "lls": "./dist/server/src/index.js"
  },
  "main": "./dist/server/src/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc --project tsconfig.server.json",
    "build:client": "cd client && npm run build",
    "start": "node dist/server/src/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "claude",
    "skills",
    "claude-code",
    "ai-tools"
  ],
  "author": "Robert So",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
